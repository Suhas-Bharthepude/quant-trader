# Template for environment configuration.
# Copy this file to .env and fill in real values. Never commit .env to version control.

APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

LOG_LEVEL=INFO

# Email notifier (optional). If any of these is unset, run_daily degrades to logging-only.
# SMTP_APP_PASSWORD is a Gmail APP PASSWORD (16 chars, no spaces) - NOT your account password.
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
ALERT_EMAIL_TO=where_to_send_alerts@example.com
